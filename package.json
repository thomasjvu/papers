{
  "name": "papers",
  "version": "0.1.0",
  "private": true,
  "description": "Static documentation template built with React, Vite, and TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasjvu/papers.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run resolve:theme && npm run generate:icons && npm run generate:design-book && npm run generate:openapi && npm run generate:docs && npm run generate:seo -- --mode development && vite",
    "build": "npm run resolve:theme && npm run generate:icons && npm run generate:design-book && npm run generate:openapi && npm run generate:llms && npm run generate:docs && npm run generate:seo -- --mode production && tsc -b && vite build && npm run generate:route-html -- --mode production && npm run generate:pagefind && npm run write:build-manifest",
    "generate:design-book": "node scripts/generate-design-book.mjs",
    "resolve:theme": "node scripts/resolve-theme.mjs",
    "papers:theme": "node scripts/papers-theme.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,mdx}\"",
    "type-check": "tsc --noEmit",
    "test": "node --import ./test/register-ts-node.mjs ./test/run-tests.mjs",
    "release:check": "npm run docs:check && npm run check:docs-tree && npm run check:security-policy && npm run check:assets && npm run check:runtime-audit && npm run package:check && npm run release:artifact-check && npm run release:preview-check",
    "deploy": "npx wrangler pages deploy dist",
    "deploy:create": "npx wrangler pages project create papers-docs --production-branch main",
    "prepare": "husky",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:openapi": "node scripts/generate-openapi-artifacts.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "generate:pagefind": "node scripts/generate-pagefind.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "generate:route-html": "node scripts/generate-route-html.mjs",
    "write:build-manifest": "node scripts/write-build-manifest.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "sync:generated": "node scripts/sync-generated-docs.mjs",
    "sync:docs-tree": "node scripts/sync-documentation-tree.mjs",
    "create": "node packages/create-papers/index.mjs",
    "publish:create-papers": "npm publish --prefix packages/create-papers --provenance --access public",
    "package:check": "node scripts/check-create-papers-package.mjs",
    "create:smoke": "node scripts/create-papers-smoke.mjs",
    "check:docs-tree": "node scripts/sync-documentation-tree.mjs --check",
    "check:security-policy": "node scripts/check-security-policy.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:runtime-audit": "npm audit --omit=dev --audit-level=high --json",
    "check:deployment": "node scripts/check-deployment-config.mjs",
    "release:artifact-check": "node scripts/release-smoke.mjs",
    "release:preview-check": "node scripts/preview-smoke.mjs",
    "postdeploy:smoke": "node scripts/postdeploy-smoke.mjs",
    "browser:check": "npm run build && playwright test",
    "lighthouse:check": "node scripts/lighthouse-check.mjs",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:update": "node scripts/visual-check.mjs --update"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@iconify-json/mingcute": "^1.2.3",
    "@iconify-json/pixelarticons": "^1.2.6",
    "@iconify/react": "^6.0.0",
    "@scalar/api-reference": "^1.66.1",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.11.0",
    "katex": "^0.16.47 || ^0.18.10",
    "marked": "^15.0.11",
    "marked-highlight": "^2.2.1",
    "mermaid": "^11.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "lint-staged": "^16.1.2",
    "pagefind": "^1.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "yaml": "^2.9.0"
  }
}
