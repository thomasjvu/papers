{
  "$comment": "Paths the upgrader never touches: site content, branding, generated artifacts, lockfiles, CI, and tooling used only to develop Papers itself. Everything else is framework code and is upgraded with a three-way merge.",
  "siteOwned": [
    ".github/**",
    ".forgejo/**",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "docs/**",
    "packages/**",
    "plans/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "wrangler.toml",
    "public/docs-content/**",
    "src/docs/content/**",
    "src/lib/generated/**",
    "papers.lock.json",
    ".jscpd.json",
    "stryker.config.json",
    "lighthouserc.cjs",
    "scripts/quality/**",
    "scripts/check-create-papers-package.mjs",
    "scripts/create-papers-smoke.mjs",
    "public/agents.json",
    "public/collections.json",
    "public/docs-collection.json",
    "public/docs-index.json",
    "public/docs-references.json",
    "public/llms.txt",
    "public/llms-full.txt",
    "public/skill.md",
    "public/openapi-artifacts.json",
    "public/papers-theme-assets.json",
    "public/sitemap.xml",
    "public/robots.txt",
    "public/openapi-*.yaml",
    "public/images/og-image.svg",
    "public/images/twitter-card.svg",
    "public/images/docs/**",
    "release-please-config.json",
    ".release-please-manifest.json"
  ],
  "packageJson": {
    "$comment": "package.json is merged key by key. Site identity fields stay the site's, and Papers-only scripts and dependencies are not added to sites.",
    "skipFields": [
      "name",
      "version",
      "description",
      "license",
      "repository",
      "homepage",
      "private",
      "bin",
      "files",
      "publishConfig",
      "bugs",
      "keywords",
      "exports"
    ],
    "skipScripts": [
      "create",
      "publish:create-papers",
      "package:check",
      "create:smoke",
      "release:check:papers",
      "quality:coverage",
      "quality:crap",
      "quality:dup",
      "quality:mutate",
      "lighthouse:check"
    ],
    "skipDependencies": ["@stryker-mutator/core", "c8", "jscpd", "lighthouse"]
  }
}
