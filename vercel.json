{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/docs/:path*.html"
    },
    {
      "source": "/llms",
      "destination": "/llms.html"
    },
    {
      "source": "/skill",
      "destination": "/skill.html"
    }
  ]
}
